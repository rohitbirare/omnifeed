# ==============================================================================
# OmniFeed Configuration
# Autonomous Multimodal Content Pipeline for the Qoneqt Global Feed
# ==============================================================================

# ==============================================================================
# REQUIRED CONFIGURATION (Pipeline will not run without these)
# ==============================================================================

# LLM Provider (OpenAI-compatible chat completions or Google Gemini)
# Any OpenAI-compatible chat endpoint (OpenAI, OpenRouter, Groq, Together, vLLM, Gemini)
LLM_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"
LLM_API_KEY=""
LLM_MODEL="gemini-3.8-flash"

# Optional fallback model if the primary model errors or times out
LLM_FALLBACK_MODEL=""

# Google Gemini API key (automatically recognized as LLM_API_KEY if LLM_API_KEY is unset)
GEMINI_API_KEY=""

# Stock Photography Provider (Pixabay API, REQUIRED for scene visual generation)
# Get a free key at https://pixabay.com/api/docs/
PIXABAY_API_KEY=""

# ==============================================================================
# OPTIONAL CONFIGURATION (App starts and runs fully with these unset or empty)
# ==============================================================================

# AI Image Generation (OpenAI-compatible /images/generations, OPTIONAL)
# If left unset/empty, the pipeline uses the required Pixabay provider for visuals.
IMAGE_BASE_URL=""
IMAGE_API_KEY=""
IMAGE_MODEL="dall-e-3"

# Qoneqt Global Feed Direct API Upload (OPTIONAL)
# If left unset/empty, the pipeline uses guided Assisted Publishing mode (default).
QONEQT_API_BASE=""
QONEQT_API_TOKEN=""
QONEQT_UPLOAD_PATH="/api/v1/posts/upload"
QONEQT_FIELD_NAME="file"
QONEQT_APP_URL="https://qoneqt.com"

# ------------------------------------------------------------------------------
# Server & Runtime Settings
# ------------------------------------------------------------------------------
PORT=3000
HOST="0.0.0.0"
DATA_DIR="./data"
MAX_CONCURRENT_RENDERS=2
